<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup 留着：收藏、进度、播放源列表是用户自己攒的东西，换机时正该跟着走。
      但用户填的站点凭证（SourceConfig.authToken）不能跟着走 —— 它明文躺在
      `cinehub` 那份 DataStore 里，而默认的自动备份会把内部存储整个搬去云端。
      两份规则文件（12+ 用 dataExtractionRules、更早用 fullBackupContent）
      把那一份排除掉，其余照旧。
    -->
    <application
        android:name=".CineHubApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:theme="@style/Theme.CineHub">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.CineHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
